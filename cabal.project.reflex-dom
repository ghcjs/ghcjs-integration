-- Build reflex-dom-core against the local (regenerated) jsaddle-dom/ghcjs-dom:
--   cabal build --project-file=cabal.project.reflex-dom reflex-dom-core
import: cabal.project
import: cabal.project.local
packages: reflex-dom/reflex-dom-core
-- reflex / reflex-dom-core upper bounds predate GHC 9.14
allow-newer: reflex:*, reflex-dom-core:*, patch:*, *:base, *:template-haskell, *:ghc-prim
-- reflex 0.9.4.1 predates semialign 1.4 (Unzip became a superclass of Semialign)
constraints: semialign < 1.4
